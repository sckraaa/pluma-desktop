# A development server: the computer that runs both the desktop app and the
# server repository's docker compose stack. Builds for a real server take the
# address and the key from the repository variables (README).
PLUMA_SERVER_IPV4=127.0.0.1
PLUMA_SERVER_PORT=10443
# The data folder of a development build: not the one of a build for the
# real server, whose address it would read (and the other way round).
PLUMA_DATA_NAME=PlumaDev
