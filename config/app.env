# Identity of the Pluma desktop app (ci/patch.py). It differs from Telegram
# Desktop's in every place the two could collide on one computer: the data
# folder, the single-instance lock, the shortcuts, the notifications.
# Changing any of these values after a release makes the app a different one
# to the system (a new data folder, new shortcuts), so they stay as they are.
PLUMA_APP_NAME=Pluma
# The macOS bundle ID and the Linux application ID (Wayland app_id, D-Bus
# name; the .desktop file is chat.pluma.desktop.desktop).
PLUMA_APP_ID=chat.pluma.desktop
# Windows: the AppUserModelID (taskbar, notifications), and Pluma's own
# GUIDs in place of Telegram Desktop's: the application (uninstall registry
# key), the single-instance lock, the COM class notifications activate.
PLUMA_WINDOWS_APP_USER_MODEL_ID=Pluma.PlumaDesktop
PLUMA_WINDOWS_APP_GUID=BB4EA67A-F90A-4B50-B202-49660CE32557
PLUMA_INSTANCE_GUID=BC9AF030-72DA-400E-8363-5E5CC0C05F70
PLUMA_TOAST_ACTIVATOR_CLSID=1BE834F0-6DC2-429A-9B59-2B262F6AA37C
# api_id and api_hash identify the app to the server (not secrets: every
# client carries them). Pluma: 10001 Android, 10002 iOS, 10003 Desktop, 10004 Web.
PLUMA_API_ID=10003
PLUMA_API_HASH=c62739c93dc105640862bf4dcea3ba1d
