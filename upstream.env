# The telegramdesktop/tdesktop release Pluma is built from: the tag v7.4.1,
# of MTProto layer 233, pinned by its commit. ci/patch.py
# checks that the checkout matches these values; an update changes them
# together.
UPSTREAM_REPO=https://github.com/telegramdesktop/tdesktop.git
UPSTREAM_TAG=v7.4.1
UPSTREAM_REF=157f5cfc85e2dd1fa67f129a5e31a81db5ddeb19
UPSTREAM_VERSION=7.4.1
UPSTREAM_LAYER=233
# The toolchain of the tag's own CI and build documents:
# - Qt of Telegram/build/qt_version.py (macOS, and Windows with qt6);
# - the Windows SDK and the MSVC toolset of docs/building-win.md;
# - the ccache of .github/workflows/linux.yml (the build itself runs in the
#   image of Telegram/build/docker/centos_env: Rocky Linux 8, gcc-toolset-15);
# - Xcode: upstream takes the default one of macos-latest (macos-26), so this
#   is the default of the macos-26 image when the tag was pinned.
QT_VERSION=6.11.2
WINDOWS_SDK=10.0.26100.0
MSVC_TOOLSET=14.44
XCODE_VERSION=26.6
CCACHE_VERSION=4.13.6
# BuildKit for the Linux toolchain image (ci/linux-env.sh), by digest.
BUILDKIT_IMAGE=moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea
